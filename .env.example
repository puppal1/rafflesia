# created: 2026-11-23T19:02:00-08:00
# updated: 2026-11-23T21:25:00-08:00 — never commit real keys; CI uses repo secrets
# updated: 2026-11-24T23:40:00-08:00 — optional Turnstile for AI-resistant auth challenge
# Copy to .env.local for local dev only.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# Cloudflare Turnstile (optional but recommended vs AI bots)
# Site key is public (safe in Vite). Secret stays in Supabase: TURNSTILE_SECRET_KEY
# Dashboard: https://dash.cloudflare.com/ → Turnstile → Add site (puppal1.github.io)
VITE_TURNSTILE_SITE_KEY=
